{
  "name": "solarchain-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "configure:local": "hardhat run scripts/configure.ts --network localhost",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "export:local": "hardhat run scripts/export-artifacts.ts --network localhost",
    "bootstrap:local": "npm run deploy:local && npm run configure:local && npm run seed:local && npm run export:local",
    "lint": "eslint \"{contracts,scripts,test}/**/*.{ts,sol}\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "hardhat": "^2.22.17",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
